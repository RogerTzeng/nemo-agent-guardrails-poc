# NVIDIA NIM：填入 key 與你可使用的 generation model。
NVIDIA_API_KEY=
base_url=https://integrate.api.nvidia.com/v1
LLM=
CONTENT_SAFETY=nvidia/nemotron-3.5-content-safety

# 至少 24 字元；僅供 service 管理者使用。
GUARDRAIL_ADMIN_KEY=
SAFETY_ENABLE_THINKING=false

# 可選：Policy review 使用另一組 OpenAI-compatible endpoint。
# POLICY_CONFLICT_API_KEY=
# POLICY_CONFLICT_BASE_URL=
# POLICY_CONFLICT_MODEL=

# 可選：DeepAgents generation model，預設使用上面的 NIM 設定。
# AGENT_API_KEY=
# AGENT_BASE_URL=
# AGENT_MODEL=

# 其他 native rails 需要的 provider key，依啟用的 service preset 設定。
# ACTIVEFENCE_API_KEY=
# AI_DEFENSE_API_ENDPOINT=
# AI_DEFENSE_API_KEY=
# CLAVATA_API_KEY=
# CLEANLAB_API_KEY=
# CS_AIDR_TOKEN=
# F5_GUARDRAILS_API_KEY=
# FIDDLER_API_KEY=
# PANGEA_API_TOKEN=
# POLICYAI_API_KEY=
# PS_APP_ID=
# PS_PROTECT_URL=
